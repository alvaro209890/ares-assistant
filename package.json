{
  "name": "ares-assistant",
  "version": "0.28.0",
  "description": "ARES — Assistente de IA pessoal estilo JARVIS (app desktop Electron)",
  "author": "acer",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit",
    "verify": "npm run test && npm run build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:linux": "electron-vite build && electron-builder --linux deb AppImage --publish never",
    "dist:deb": "electron-vite build && electron-builder --linux deb --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:all": "electron-vite build && electron-builder --linux deb AppImage --win nsis --publish never"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
