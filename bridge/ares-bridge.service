[Unit]
Description=Ares Bridge — ponte local Hermes/Code movida a 9Router
Documentation=https://github.com/alvaro209890/ares-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documentos/Ares
# Usa o node do sistema de propósito: o bridge só depende de http + fetch (Node >=18 basta),
# então não precisa do nvm. Se mover o repo, ajuste os caminhos abaixo.
ExecStart=/usr/bin/node %h/Documentos/Ares/bridge/server.mjs
Environment=ARES_BRIDGE_PORT=18789
Environment=ARES_BRIDGE_HOST=127.0.0.1
Environment=NINEROUTER_BASE_URL=http://localhost:20128/v1
Environment=NINEROUTER_MODEL=cx/gpt-5.5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
